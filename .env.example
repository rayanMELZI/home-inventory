# Copy to .env and fill in real values. NEVER commit .env.

# PostgreSQL
POSTGRES_DB=homestock
POSTGRES_USER=homestock
POSTGRES_PASSWORD=change-me

# Backend
# Generate with: openssl rand -base64 48
#   (or: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))")
JWT_SECRET=
# true when serving over HTTPS (production)
SECURE_COOKIES=false

# Meal suggestions (optional — leave blank and the rest of the app is unaffected).
# Key: https://aistudio.google.com/apikey — the free tier covers personal use.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
